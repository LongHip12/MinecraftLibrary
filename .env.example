# ─── Flask ───────────────────────────────────────────
  SECRET_KEY=your_flask_secret_key_here

  # ─── OpenRouter ──────────────────────────────────────
  OPENROUTER_API_KEY=your_openrouter_fallback_key
  OPENROUTER_GPT4O_MINI_KEY=your_openrouter_key_for_gpt4o_mini
  OPENROUTER_LONELY_AI_KEY=your_openrouter_or_poolside_key_for_lonely_ai

  # ─── NVIDIA NIM ──────────────────────────────────────
  NVIDIA_NEMOTRON_KEY=your_nvidia_key_for_nemotron
  NVIDIA_DEEPSEEK_KEY=your_nvidia_key_for_deepseek_v4_flash
  NVIDIA_LLAMA_KEY=your_nvidia_key_for_llama_3_3_70b
  NVIDIA_KIMI_KEY=your_nvidia_key_for_kimi_k2_6

  # ─── Google Gemini ───────────────────────────────────
  GOOGLE_GEMINI_KEY=your_google_ai_studio_api_key

  # ─── Poolside (fallback for Lonely AI) ───────────────
  POOLSIDE_API_KEY=your_poolside_api_key

  # ─── Discord OAuth ────────────────────────────────────
  DISCORD_CLIENT_ID=your_discord_client_id
  DISCORD_CLIENT_SECRET=your_discord_client_secret
  DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback
  